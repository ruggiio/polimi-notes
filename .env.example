# Copia in .env (gitignored). Le credenziali NON vengono usate dagli script automatici:
# il login (password + CIE) si fa una volta ogni ~10 giorni con tools/sso_login.py.
POLIMI_USER=10XXXXXX                          # Codice Persona
POLIMI_EMAIL=nome.cognome@mail.polimi.it      # email dichiarata dall'IdP (quella che usi su Webex)
POLIMI_PASS=                                  # opzionale, solo per il vecchio flusso main.py run
# ANTHROPIC_API_KEY=sk-ant-...                # solo se notes.backend: claude (API) invece di claude-code
